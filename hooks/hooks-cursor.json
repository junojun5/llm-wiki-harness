{
  "description": "Cursor 훅 템플릿. install.sh가 {{HOOKS_DIR}}를 절대경로로 바꾼다. Claude 설정과 같이 등록하면 두 번 돈다.",
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "\"{{HOOKS_DIR}}/run-hook.cmd\" session-start cursor" }
    ],
    "preToolUse": [
      { "command": "\"{{HOOKS_DIR}}/run-hook.cmd\" wiki-protect-raw.sh cursor", "matcher": "Write|Edit|Shell" }
    ],
    "postToolUse": [
      { "command": "\"{{HOOKS_DIR}}/run-hook.cmd\" wiki-validate-frontmatter.sh", "matcher": "Write|Edit" }
    ]
  }
}
