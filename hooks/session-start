#!/usr/bin/env bash
# session-start [platform] — 두 가지를 한다:
#   ① 런타임 부트스트랩: ~/.llm-wiki/scripts가 없으면 이 배포본(플러그인 루트/repo)의 scripts/에서
#      symlink로 생성한다. 마켓플레이스(install.sh 없이) 설치에서도 스킬·훅이 동작하게 하는 자가치유.
#   ② 볼트 컨텍스트 주입: CWD가 실제 볼트 안일 때만 using-llm-wiki SKILL.md를 세션 컨텍스트로 주입.
#      전역 등록(마켓플레이스)돼도 볼트 밖 세션엔 주입하지 않는다(스팸 방지, 하네스 스펙 §5-0·§5-1).
# 인자 $1 = 플랫폼(claude|codex|cursor). 출력은 플랫폼별 stdout JSON, 본문은 <EXTREMELY_IMPORTANT> 래핑.
# Antigravity는 훅 미사용(AGENTS.md 상시 로드로 대체).
set -u
PLATFORM="${1:-claude}"
SELF="$(python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

# ① 런타임 부트스트랩 (멱등·조용·비치명) — 없을 때, 깨졌을 때, 형제 버전을 가리킬 때.
LLMWIKI="$HOME/.llm-wiki/scripts"
mkdir -p "$LLMWIKI" 2>/dev/null || true

# 마켓플레이스 캐시는 버전별 디렉토리다(.../cache/<mp>/<plugin>/<version>/). 플러그인을
# 업데이트하면 새 버전 디렉토리가 생기는데, 기존 symlink는 **구버전을 계속 가리킨다** —
# 존재 여부만 보면 영구히 stale해지고 스킬·훅이 옛 스크립트를 호출한다(2026-08-01 실측:
# 캐시는 0.2.0인데 런타임 홈은 0.1.0이라 고친 결함이 그대로 재현됐다).
# 그래서 **같은 플러그인의 형제 버전을 가리킬 때만** 재지정한다.
# install.sh는 사용자 클론을 가리키게 만드므로(비파괴 정책) 그 경우는 판정 자체를 끈다 —
# ROOT가 플러그인 캐시 안일 때만 형제 재지정을 활성화한다.
# 비교는 **물리 경로**로 한다 — readlink는 저장된 원문을 돌려주므로 심볼릭 부모를 포함할 수
# 있고(macOS의 /var → /private/var 등), 원문끼리 비교하면 형제 판정이 조용히 빗나간다.
case "$ROOT" in
  */plugins/cache/*) SIBLING_ROOT="$(cd "$(dirname "$ROOT")" 2>/dev/null && pwd -P)" ;;
  *)                 SIBLING_ROOT="" ;;
esac

for f in resolve-vault.sh validate-frontmatter.sh build-link-graph.sh; do
  SRC="$ROOT/scripts/$f"; DST="$LLMWIKI/$f"
  [ -e "$SRC" ] || continue
  if [ -L "$DST" ]; then
    CUR="$(readlink "$DST" 2>/dev/null || true)"
    [ "$CUR" = "$SRC" ] && continue                       # 이미 이 배포본
    if [ ! -e "$DST" ]; then                              # 깨진 링크 → 복구
      ln -sfn "$SRC" "$DST" 2>/dev/null || true; continue
    fi
    if [ -n "$SIBLING_ROOT" ]; then                       # 형제 버전만 재지정
      CURDIR="$(cd "$(dirname "$CUR")" 2>/dev/null && pwd -P)"
      case "$CURDIR" in "$SIBLING_ROOT"/*) ln -sfn "$SRC" "$DST" 2>/dev/null || true ;; esac
    fi
    continue                                              # 그 밖(사용자 클론 등)은 보존
  fi
  [ -e "$DST" ] && continue                               # symlink 아닌 실제 파일 = 사용자 소유
  ln -sfn "$SRC" "$DST" 2>/dev/null || true
done

# ② 볼트 게이트 — 볼트가 설정돼 있고(resolve 성공) CWD가 그 볼트 안일 때만 주입.
RESOLVED="$(bash "$LLMWIKI/resolve-vault.sh" 2>/dev/null)" || exit 0   # 설정된 볼트 없음 → 부트스트랩만
VAULT_PATH="$(printf '%s\n' "$RESOLVED" | sed -n 's/^VAULT_PATH=//p')"
[ -n "$VAULT_PATH" ] || exit 0
case "$PWD/" in "$VAULT_PATH"/*) ;; *) exit 0 ;; esac   # CWD가 볼트 밖 → 주입 안 함(전역 스팸 방지)

SKILL="$ROOT/skills/using-llm-wiki/SKILL.md"
[ -f "$SKILL" ] || { echo "using-llm-wiki SKILL.md를 찾을 수 없습니다: $SKILL" >&2; exit 2; }

# ③ 플랫폼 판별은 argv보다 페이로드가 우선한다 (§5-1). Cursor는 Claude 포맷 등록
#    (~/.claude/settings.json 등)도 실행하므로 argv가 `claude`인 채 Cursor에서 발화할 수 있다.
#    페이로드에 cursor_version 키가 있으면 Cursor로 판정한다.
#    ⚠️ stdin 읽기에 반드시 상한을 둔다. TTY 제외만으로는 부족하다 — 페이로드가 오지 않는
#    경로(수동 실행, 닫히지 않은 파이프를 상속한 경우)에서 `cat`이 무한 대기하면
#    **세션 시작 자체가 멈춘다**. 줄당 대기 상한 2초, 실제 훅 호출은 쓰고 바로 닫으므로
#    지연이 없다.
INPUT=""
if [ ! -t 0 ]; then
  _line=""
  while IFS= read -r -t 2 _line || [ -n "$_line" ]; do
    INPUT="$INPUT$_line"
    _line=""
  done
fi
if [ -n "$INPUT" ] && printf '%s' "$INPUT" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
sys.exit(0 if isinstance(d, dict) and "cursor_version" in d else 1)
' 2>/dev/null; then
  PLATFORM="cursor"
fi

python3 - "$SKILL" "$PLATFORM" "$LLMWIKI/resolve-vault.sh" <<'PY'
import json, sys, re
skill_path, platform, resolver = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(skill_path, encoding="utf-8").read()
body = re.sub(r'^---\n.*?\n---\n', '', text, count=1, flags=re.S).strip()   # frontmatter 제거
wrapped = "<EXTREMELY_IMPORTANT>\n" + body + "\n</EXTREMELY_IMPORTANT>"

# 출력 포맷은 2026-07-31 실측 확정 (§5-1).
if platform in ("claude", "codex"):
    # Codex는 Claude와 **동일 포맷**이다. {"additional_context":…}를 내보내면
    # `hook: SessionStart Failed`로 끝나고 주입이 조용히 무효가 된다.
    out = {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": wrapped}}
elif platform == "cursor":
    # Cursor엔 hookSpecificOutput 래퍼가 없다(실측). env 값은 틸드가 확장되지 않으므로 절대경로.
    out = {"additional_context": wrapped,
           "env": {"LLM_WIKI_RESOLVER": resolver}}
else:
    sys.stderr.write("unknown platform: %s\n" % platform); sys.exit(2)

print(json.dumps(out, ensure_ascii=False))
PY
