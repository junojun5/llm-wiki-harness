#!/usr/bin/env bash
# session-start [platform] — ~/.llm-wiki/scripts를 자가치유하고, CWD가 볼트 안일 때만 SKILL.md를 주입한다.
set -u
PLATFORM="${1:-claude}"

# 경로 해석은 python3를 쓰지 않는다. 없으면 ROOT가 CWD 부모로 잡혀 부트스트랩과 경고가 같이 죽는다.
SELF="${BASH_SOURCE[0]}"
_hops=0
while [ -L "$SELF" ] && [ "$_hops" -lt 20 ]; do
  _t="$(readlink "$SELF" 2>/dev/null || true)"
  [ -n "$_t" ] || break
  case "$_t" in /*) SELF="$_t" ;; *) SELF="$(dirname "$SELF")/$_t" ;; esac
  _hops=$((_hops+1))
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"

# stdin은 줄당 2초 상한. 페이로드 없이 파이프가 열려 있으면 세션 시작이 멈춘다.
INPUT=""
read_payload() {
  INPUT=""
  [ -t 0 ] && return 0
  local _line=""
  while IFS= read -r -t 2 _line || [ -n "$_line" ]; do
    INPUT="$INPUT$_line"
    _line=""
  done
}

# python3 없이 경고를 낸다. Claude·Codex는 hookSpecificOutput, Cursor는 additional_context.
emit_runtime_warning() {
  local _m="<EXTREMELY_IMPORTANT>\npython3를 PATH에서 찾을 수 없습니다. LLM Wiki의 스킬 12종과 가드 훅 2종이 모두 비활성입니다 — raw/ 쓰기 보호와 frontmatter 검증이 동작하지 않습니다. python3를 설치한 뒤 세션을 다시 시작하세요. wiki-setup --repair로는 해결되지 않습니다.\n</EXTREMELY_IMPORTANT>"
  case "$PLATFORM" in
    cursor) printf '{"additional_context":"%s"}\n' "$_m" ;;
    *)      printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$_m" ;;
  esac
  printf 'E_NO_RUNTIME: python3 부재 — LLM Wiki 스킬·가드 훅이 비활성입니다. python3를 설치한 뒤 세션을 다시 시작하세요 (wiki-setup --repair로는 해결되지 않습니다)\n' >&2
}

# 런타임 부트스트랩. 없을 때, 깨졌을 때, 같은 플러그인의 형제 버전일 때만 다시 놓는다.
LLMWIKI="$HOME/.llm-wiki/scripts"
mkdir -p "$LLMWIKI" 2>/dev/null || true

# 플러그인 캐시 안일 때만 형제 버전을 재지정한다. 사용자 클론은 보존. 비교는 물리 경로.
case "$ROOT" in
  */plugins/cache/*) SIBLING_ROOT="$(cd "$(dirname "$ROOT")" 2>/dev/null && pwd -P)" ;;
  *)                 SIBLING_ROOT="" ;;
esac

# 소유는 원장이다. MSYS ln -s는 복사라 -L로 구분하지 못하고, 이 훅은 install.sh 없이 돈다.
LEDGER="$HOME/.llm-wiki/.placements"
# 원장 I/O는 bash 내장만 쓴다. grep·cut·cp·mv·rm은 축소 PATH에 없다.
_rec_src() { # _rec_src <dest> → 기록된 src (없으면 빈 문자열)
  local m d s out=""
  [ -f "$LEDGER" ] || return 0
  while IFS=$'\t' read -r m d s; do
    [ "$d" = "$1" ] && out="$s"
  done <"$LEDGER"
  printf '%s' "$out"
}
_rec_put() { # _rec_put <dest> <src> <mechanism>
  local m d s buf=""
  if [ -f "$LEDGER" ]; then
    while IFS=$'\t' read -r m d s; do
      [ "$d" = "$1" ] && continue
      buf="$buf$m"$'\t'"$d"$'\t'"$s"$'\n'
    done <"$LEDGER"
  fi
  buf="$buf$3"$'\t'"$1"$'\t'"$2"$'\n'
  # mv는 축소 PATH에 없다. 원장은 다음 세션이 다시 만드는 부트스트랩 메모다.
  printf '%s' "$buf" >"$LEDGER" 2>/dev/null || true
}
_same() { # _same <a> <b> — 내용이 같은가. `cmp`는 축소 PATH 밖이라 `cat`으로 비교한다
  local _a _b                                  # ($(...)가 양쪽 끝 개행을 똑같이 벗기므로 비교는 유효)
  [ -f "$1" ] && [ -f "$2" ] || return 1
  _a="$(cat "$1" 2>/dev/null)" || return 1
  _b="$(cat "$2" 2>/dev/null)" || return 1
  [ "$_a" = "$_b" ]
}
_place() { # _place <src> <dst> — 배치하고 원장에 남긴다. 실패는 조용히 넘긴다(비치명 계약).
  local mech=symlink
  ln -sfn "$1" "$2" 2>/dev/null || true
  if [ ! -L "$2" ]; then
    # MSYS는 ln이 복사로 떨어진다. chmod는 축소 PATH 밖이고, 호출은 전부 bash라 실행 비트가 필요 없다.
    cat "$1" >"$2" 2>/dev/null || return 0
    mech=copy
  fi
  _rec_put "$2" "$1" "$mech"
}

for f in resolve-vault.sh validate-frontmatter.sh build-link-graph.sh; do
  SRC="$ROOT/scripts/$f"; DST="$LLMWIKI/$f"
  [ -e "$SRC" ] || continue

  # 원장이 없으면 symlink 원문으로 폴백한다. 없으면 기존 설치가 사용자 소유로 읽힌다.
  CUR="$(_rec_src "$DST")"
  [ -z "$CUR" ] && [ -L "$DST" ] && CUR="$(readlink "$DST" 2>/dev/null || true)"

  # 내용이 같으면 원장 이전 복사본이다. 다시 놓아도 디스크는 같고, 사용자가 고친 파일은 여기 안 걸린다.
  if [ -z "$CUR" ] && _same "$DST" "$SRC"; then
    _place "$SRC" "$DST"; continue
  fi

  if [ -z "$CUR" ]; then
    [ -e "$DST" ] && continue                             # 원장에 없고 실제 파일 = 사용자 소유
    _place "$SRC" "$DST"; continue                         # 비어 있으면 새로 놓는다
  fi
  [ "$CUR" = "$SRC" ] && { [ -e "$DST" ] || _place "$SRC" "$DST"; continue; }  # 이 배포본(깨졌으면 복구)
  [ -e "$DST" ] || { _place "$SRC" "$DST"; continue; }                          # 깨진 배치 → 복구
  # 우리 것이지만 출처가 다르다 → **형제 버전일 때만** 재지정하고 사용자 클론은 보존한다.
  if [ -n "$SIBLING_ROOT" ]; then
    CURDIR="$(cd "$(dirname "$CUR")" 2>/dev/null && pwd -P)"
    case "$CURDIR" in "$SIBLING_ROOT"/*) _place "$SRC" "$DST" ;; esac
  fi
done

# 볼트가 resolve되고 CWD가 그 안일 때만 주입한다.
RESOLVED="$(bash "$LLMWIKI/resolve-vault.sh" 2>/dev/null)"; RC=$?

# exit 7은 볼트가 있는 머신의 python3 부재다. 세션당 1회만 알리고, 가드 훅은 통과시킨다.
if [ "$RC" -eq 7 ]; then
  # 이 분기에서만 읽는다. 앞으로 올리면 볼트 밖 세션도 대기를 낸다.
  read_payload
  # python3가 없으므로 cursor_version 문자열만 본다.
  case "$INPUT" in *cursor_version*) PLATFORM="cursor" ;; esac
  emit_runtime_warning
  exit 0
fi
[ "$RC" -eq 0 ] || exit 0   # 그 외 실패(볼트 없음·무효) → 현행대로 조용히, 부트스트랩만

VAULT_PATH="$(printf '%s\n' "$RESOLVED" | sed -n 's/^VAULT_PATH=//p')"
[ -n "$VAULT_PATH" ] || exit 0
# 볼트 밖이면 주입하지 않는다. $PWD와 config 경로 표기가 다를 수 있어, 어긋나면 cd+pwd로 한 번 더 본다.
case "$PWD/" in
  "$VAULT_PATH"/*) ;;
  *)
    VAULT_REAL="$(cd "$VAULT_PATH" 2>/dev/null && pwd)" || VAULT_REAL=""
    [ -n "$VAULT_REAL" ] || exit 0
    case "$PWD/" in "$VAULT_REAL"/*) ;; *) exit 0 ;; esac ;;
esac

SKILL="$ROOT/skills/using-llm-wiki/SKILL.md"
[ -f "$SKILL" ] || { echo "using-llm-wiki SKILL.md를 찾을 수 없습니다: $SKILL" >&2; exit 2; }

# argv보다 페이로드가 우선이다. cursor_version이 있으면 Cursor다.
read_payload
if [ -n "$INPUT" ] && printf '%s' "$INPUT" | PYTHONUTF8=1 python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
sys.exit(0 if isinstance(d, dict) and "cursor_version" in d else 1)
' 2>/dev/null; then
  PLATFORM="cursor"
fi

# SKILL.md는 한국어다. UTF-8을 고정하지 않으면 비UTF-8 locale에서 주입 출력이 빈다.
PYTHONUTF8=1 python3 - "$SKILL" "$PLATFORM" "$LLMWIKI/resolve-vault.sh" <<'PY'
import json, sys, re
skill_path, platform, resolver = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(skill_path, encoding="utf-8").read()
body = re.sub(r'^---\n.*?\n---\n', '', text, count=1, flags=re.S).strip()   # frontmatter 제거
wrapped = "<EXTREMELY_IMPORTANT>\n" + body + "\n</EXTREMELY_IMPORTANT>"

if platform in ("claude", "codex"):
    # Codex도 Claude와 같은 포맷이다. additional_context만 내면 주입이 실패한다.
    out = {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": wrapped}}
elif platform == "cursor":
    # Cursor엔 hookSpecificOutput 래퍼가 없다(실측). env 값은 틸드가 확장되지 않으므로 절대경로.
    out = {"additional_context": wrapped,
           "env": {"LLM_WIKI_RESOLVER": resolver}}
else:
    sys.stderr.write("unknown platform: %s\n" % platform); sys.exit(2)

print(json.dumps(out, ensure_ascii=False))
PY
