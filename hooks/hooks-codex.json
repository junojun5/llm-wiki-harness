{
  "description": "LLM Wiki 하네스 가드 훅 — raw/ 보호·frontmatter 검증·볼트 컨텍스트 주입. 설치 후 /hooks에서 trust 필요(미완 시 무경고 no-op). 상세는 docs/specs/hooks-and-scripts.md 참조.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/run-hook.cmd\" session-start codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|apply_patch|shell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/run-hook.cmd\" wiki-protect-raw.sh codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/run-hook.cmd\" wiki-validate-frontmatter.sh"
          }
        ]
      }
    ]
  }
}
